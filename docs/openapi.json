{
  "openapi": "3.1.0",
  "info": {
    "title": "Event Ticketing API",
    "version": "0.5.0",
    "description": "The Build 4 API: create events and ticket tiers, publish them, search, book, pay with a mock card and cancel.\n\nSince Build 5, data is stored in **SQLite** (`data/ticketing.db`) and survives a restart. When many people book the last seats at the same moment, exactly enough of them succeed and the rest get `SOLD_OUT`.\n\n**Who you are.** Until Build 7 adds login, send an `x-user-id` header on every call that changes data.\n\n**Money** is always a whole number of the smallest unit (kobo or cents): `500000` is 5,000.00.\n\n**Errors** always have the same shape: `{ \"error\": { \"code\": \"SOLD_OUT\", \"message\": \"...\" } }`."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "tags": [
    {
      "name": "Events",
      "description": "Organizers create and publish events. Anyone can search published ones."
    },
    {
      "name": "Bookings",
      "description": "Attendees book, pay and cancel. Only the person who made a booking can see or change it."
    },
    {
      "name": "System"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "The server is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Create an event",
        "description": "Creates a **draft** event owned by the caller. Drafts are not on the public list. (S02)",
        "operationId": "createEvent",
        "security": [
          {
            "UserId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEvent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new draft event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetail"
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `INVALID_JSON`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No `x-user-id` header. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Search published events",
        "description": "Search, filter and sort **published** events. Every parameter is optional. (S05)",
        "operationId": "searchEvents",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Text in the title or venue, ignoring case.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Exact city, ignoring case.",
            "schema": {
              "type": "string"
            },
            "example": "lagos"
          },
          {
            "name": "from",
            "in": "query",
            "description": "Earliest start, inclusive.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Latest start, inclusive. A date-only value includes the whole day.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "maxPriceCents",
            "in": "query",
            "description": "Cheapest tier must cost at most this. Events with no tiers are left out.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "onlyAvailable",
            "in": "query",
            "description": "Only events with seats left.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "date",
                "price",
                "availability"
              ],
              "default": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching events. Ties are broken by title, then id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `INVALID_JSON`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "View an event",
        "description": "A published event, or your own draft. Includes each tier with its seats left.",
        "operationId": "getEvent",
        "security": [
          {},
          {
            "UserId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The event and its tiers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetail"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/tiers": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Add a ticket tier",
        "description": "Only the organizer of the event can add tiers. (S03)",
        "operationId": "addTier",
        "security": [
          {
            "UserId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTier"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new tier, with 0 sold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tier"
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `INVALID_JSON`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No `x-user-id` header. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You are not the owner. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/publish": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Publish an event",
        "description": "Puts the event on the public list. It needs at least one tier. (S04)",
        "operationId": "publishEvent",
        "security": [
          {
            "UserId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The published event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetail"
                }
              }
            }
          },
          "401": {
            "description": "No `x-user-id` header. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You are not the owner. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The event has no tiers. Possible codes: `INVALID_STATE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/unpublish": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Unpublish an event",
        "description": "Takes the event off the public list and makes it a draft again. (S04)",
        "operationId": "unpublishEvent",
        "security": [
          {
            "UserId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The event, now a draft.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetail"
                }
              }
            }
          },
          "401": {
            "description": "No `x-user-id` header. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You are not the owner. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Book tickets",
        "description": "Holds seats in a tier of a published event. The booking starts as `pending`. (S06)",
        "operationId": "book",
        "security": [
          {
            "UserId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewBooking"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The pending booking.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `INVALID_JSON`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No `x-user-id` header. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Not enough seats left, or the event is not published. Possible codes: `SOLD_OUT`, `INVALID_STATE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{reference}": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "View a booking",
        "operationId": "getBooking",
        "security": [
          {
            "UserId": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Booking reference, for example `A4WMMBBT`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The booking.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "401": {
            "description": "No `x-user-id` header. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You are not the owner. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{reference}/pay": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Pay for a booking (mock)",
        "description": "Pays a `pending` booking with a mock payment token. No card number is ever sent. (S07)\n\n- `tok_success` pays.\n- `tok_declined` is declined: you get `402 PAYMENT_DECLINED`, the booking stays pending, and you can try again.\n\nPaying a paid or cancelled booking is refused with `INVALID_TRANSITION`, and the card is never charged twice.",
        "operationId": "pay",
        "security": [
          {
            "UserId": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Booking reference, for example `A4WMMBBT`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "paymentToken"
                ],
                "properties": {
                  "paymentToken": {
                    "type": "string",
                    "enum": [
                      "tok_success",
                      "tok_declined"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The booking, now paid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `INVALID_JSON`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No `x-user-id` header. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "The mock card was declined. Possible codes: `PAYMENT_DECLINED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You are not the owner. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The booking is already paid or cancelled. Possible codes: `INVALID_TRANSITION`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{reference}/cancel": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Cancel an unpaid booking",
        "description": "Cancels a `pending` booking and gives its seats back. Paid bookings need a refund, which arrives in Build 8.",
        "operationId": "cancel",
        "security": [
          {
            "UserId": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Booking reference, for example `A4WMMBBT`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The booking, now cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "401": {
            "description": "No `x-user-id` header. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You are not the owner. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The booking is paid or already cancelled. Possible codes: `INVALID_STATE`, `INVALID_TRANSITION`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id",
        "description": "Who is calling, for example `ada` or `org-1`. Stands in for login until Build 7."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "SOLD_OUT"
              },
              "message": {
                "type": "string",
                "example": "Only 1 ticket(s) left in General"
              }
            }
          }
        }
      },
      "NewEvent": {
        "type": "object",
        "required": [
          "title",
          "city",
          "startsAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Lagos Tech Meetup"
          },
          "city": {
            "type": "string",
            "example": "Lagos"
          },
          "venue": {
            "type": "string",
            "example": "Landmark Centre"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-12-05T17:00:00Z"
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          },
          "tierCount": {
            "type": "integer"
          },
          "minPriceCents": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Price of the cheapest tier, or null with no tiers."
          },
          "seatsLeft": {
            "type": "integer",
            "description": "Seats left across all tiers."
          }
        }
      },
      "EventDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventSummary"
          },
          {
            "type": "object",
            "properties": {
              "organizerId": {
                "type": "string"
              },
              "tiers": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Tier"
                }
              }
            }
          }
        ]
      },
      "NewTier": {
        "type": "object",
        "required": [
          "name",
          "priceCents",
          "capacity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "General"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "example": 500000
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "example": 100
          }
        }
      },
      "Tier": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
